# Скопируйте этот файл в ".env" и подставьте свои реальные ключи.
# НИКОГДА не публикуйте .env и не коммитьте его в git.

TELEGRAM_BOT_TOKEN=paste_your_telegram_bot_token_here
GEMINI_API_KEY=paste_your_gemini_api_key_here
GOOGLE_CREDENTIALS_PATH=credentials.json

# Как часто (в секундах) бот проверяет Classroom на новые курсы в фоне.
SYNC_INTERVAL_SECONDS=60

# Порт локального веб-сервера, который ловит редирект от Google после
# авторизации (см. config.py). Меняйте OAUTH_REDIRECT_BASE_URL только
# после деплоя на хостинг с публичным адресом.
OAUTH_CALLBACK_PORT=8765
# OAUTH_REDIRECT_BASE_URL=https://ваш-адрес.onrender.com
