# Скопируйте этот файл в ".env" и подставьте свои реальные ключи.
# НИКОГДА не публикуйте .env и не коммитьте его в git.

TELEGRAM_BOT_TOKEN=paste_your_telegram_bot_token_here
GEMINI_API_KEY=paste_your_gemini_api_key_here
# Можно указать НЕСКОЛЬКО ключей через запятую (например, с разных
# бесплатных Google-аккаунтов) — бот будет пробовать их по очереди,
# если у одного кончилась квота или он временно недоступен:
# GEMINI_API_KEY=key1,key2,key3
# Модель Gemini. По умолчанию — "gemini-flash-latest" (Google сам держит
# этот алиас указывающим на актуальную стабильную flash-модель, так что
# менять обычно не нужно). Переопределите, если хотите конкретную версию.
# GEMINI_MODEL_NAME=gemini-flash-latest
GOOGLE_CREDENTIALS_PATH=credentials.json

# Как часто (в секундах) бот проверяет Classroom на новые курсы.
# В режиме polling (USE_WEBHOOK=false) — интервал встроенного фонового
# цикла. В режиме webhook (USE_WEBHOOK=true) циклом не пользуется — это
# просто рекомендуемый интервал, с которым нужно дёргать /cron/sync
# снаружи (см. ниже).
SYNC_INTERVAL_SECONDS=60

# Порт локального веб-сервера, который ловит редирект от Google после
# авторизации, вебхук Telegram и /cron/sync (см. config.py). Меняйте
# OAUTH_REDIRECT_BASE_URL только после деплоя на хостинг с публичным
# адресом.
OAUTH_CALLBACK_PORT=8765
# OAUTH_REDIRECT_BASE_URL=https://ваш-адрес.onrender.com

# ---------------------------------------------------------------------------
# Webhook вместо polling (продакшн)
# ---------------------------------------------------------------------------
# По умолчанию бот работает через long polling — постоянно опрашивает
# Telegram и держит процесс запущенным. Это удобно локально, но на
# хостинге с ограниченными часами тратит их впустую. Включите вебхук на
# проде (не забудьте задать OAUTH_REDIRECT_BASE_URL выше — это и есть
# публичный адрес для вебхука):
# USE_WEBHOOK=true

# Секретный сегмент пути вебхука. Если не задать — используется сам
# TELEGRAM_BOT_TOKEN (тоже секретный, этого достаточно).
# WEBHOOK_SECRET=any-random-string

# ---------------------------------------------------------------------------
# Заглушка для внешнего крона (эндпоинт GET /cron/sync)
# ---------------------------------------------------------------------------
# В режиме webhook синхронизация Classroom по всем пользователям
# запускается не фоновым циклом (он бы не давал сервису "спать"), а
# внешним вызовом GET {OAUTH_REDIRECT_BASE_URL}/cron/sync?key=...
# Настройте бесплатный внешний крон (cron-job.org, UptimeRobot,
# GitHub Actions по расписанию и т.п.), чтобы он дёргал этот адрес раз в
# SYNC_INTERVAL_SECONDS. CRON_SECRET — простой пароль для этого
# эндпоинта, чтобы его не мог дёрнуть кто попало.
# CRON_SECRET=any-random-string

# ---------------------------------------------------------------------------
# Админы (кнопка загрузки учебников)
# ---------------------------------------------------------------------------
# Ваш Telegram user_id (числовой, не @username — узнать можно у
# @userinfobot). Через запятую можно указать несколько админов:
# ADMIN_IDS=123456789,987654321
# ADMIN_IDS=
